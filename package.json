{
  "name": "goztepe-stat-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Göztepe Stat Bot — özgün Discord aktivite analitiği",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node scripts/deploy.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "format": "prettier --write src scripts test",
    "format:check": "prettier --check src scripts test"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "chart.js": "^4.5.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supertest": "^7.1.4"
  }
}
