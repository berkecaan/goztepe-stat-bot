# Node.js 24 LTS önerilir. Token ve OAuth secret farklı bilgilerdir.
DISCORD_TOKEN=BURAYA_BOT_TOKEN
CLIENT_ID=BURAYA_APPLICATION_ID
# Göztepe sunucu ID: doldurulursa slash komutları yalnızca bu sunucuya deploy edilir.
# Boş bırakılırsa global deploy. Bot diğer eklendiği sunucularda da veri tutabilir.
GUILD_ID=
AUTO_DEPLOY=true
DATABASE_PATH=./data/stats.sqlite

# Dashboard isteğe bağlı. Bot için false bırakabilirsiniz.
DASHBOARD_ENABLED=false
PORT=3000
BASE_URL=http://localhost:3000
CLIENT_SECRET=
# Üretim: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
# HTTPS reverse proxy arkasında tam olarak bir güvenilir proxy varsa 1; yoksa 0.
TRUST_PROXY=0
